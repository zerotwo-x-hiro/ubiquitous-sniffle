{
  "name": "ubiquitous-sniffle",
  "version": "0.1.0",
  "private": true,
  "description": "ubiquitous-sniffle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
