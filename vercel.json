{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/tvmaze/[...path].js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/tvmaze/:path*", "destination": "/api/tvmaze/[...path]" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
